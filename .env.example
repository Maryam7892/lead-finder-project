# Copy this file to ".env" if you want to use the Send Emails or Send Texts
# tabs, or to restrict which search engines are used (see below). Nothing in
# this file is required for finding/scraping leads by default — OpenStreetMap
# is genuinely free and key-free, and the web search step needs no key either.

# --- Web search engine selection (optional) ---
# The `ddgs` search library is a multi-engine metasearch client, not purely
# DuckDuckGo. Left blank, the default is:
#   google,bing,brave,yahoo,yandex
# — the reliable, high-yield engines, tried left-to-right. mojeek and
# wikipedia were dropped from the default (slow, frequent timeouts, thin
# results for this kind of query); mullvad_google / mullvad_brave are
# excluded because they DNS-fail on many networks. Multiple engines run per
# search so one rate-limiting (Google is the most aggressive) doesn't kill
# the query.
#
# Valid values: bing, brave, google, mojeek, mullvad_brave, mullvad_google,
# wikipedia, yahoo, yandex — or "auto" for all 9. If you're getting a wall
# of timeout errors, try pinning ONE engine you know works from your
# network, e.g. SEARCH_ENGINE_BACKEND=bing
SEARCH_ENGINE_BACKEND=

# Seconds to wait between search queries (default 2.5). Raising this makes
# the request pattern look less automated and can help avoid *triggering*
# new rate-limiting.
SEARCH_QUERY_DELAY=

# Per-engine HTTP timeout in seconds (default 25) and number of extra
# retries when *every* engine fails a query (default 2, with a short
# backoff between). Raise SEARCH_TIMEOUT if you see lots of
# "operation timed out" errors on an otherwise-working network.
SEARCH_TIMEOUT=
SEARCH_RETRIES=

# --- Email sending (Send Emails tab) ---
# Optional — only needed if you want to actually send emails from the app,
# rather than just exporting rendered text. Works with any SMTP provider;
# examples below are for Gmail (use an App Password, not your real password:
# https://myaccount.google.com/apppasswords) and Outlook.

# Gmail:    SMTP_HOST=smtp.gmail.com     SMTP_PORT=587
# Outlook:  SMTP_HOST=smtp.office365.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Defaults to SMTP_USERNAME if left blank. FROM_NAME is also the "Name"
# part of the email signature (e.g. "Ufaq M.") — a person's name tends to
# get better reply rates in cold outreach than a company name here.
FROM_EMAIL=
FROM_NAME=
REPLY_TO_EMAIL=

# Optional comma-separated addresses to offer in the "Send test email to"
# dropdown on the Send Emails tab (in addition to a "Custom..." option,
# which is always available). Leave blank to only get "Custom...".
TEST_EMAIL_ADDRESSES=

# Used to build the email signature (name/title/company/phone/website/
# address) and fill the {sender_name}/{sender_company}/etc merge fields.
# SENDER_ADDRESS in particular matters: CAN-SPAM legally requires a physical
# mailing address in every commercial email — don't skip it before sending.
# Any field left blank is simply omitted from the signature, not shown as
# empty. Example shape:
#   FROM_NAME=Jane Doe
#   SENDER_TITLE=Founder & Lead Bookkeeper
#   SENDER_COMPANY=Acme Bookkeeping LLC
#   SENDER_PHONE=(555) 123-4567
#   SENDER_WEBSITE=example.com
#   SENDER_ADDRESS=123 Main St STE 100, Anytown, DE 19901 United States
SENDER_TITLE=
SENDER_COMPANY=
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_ADDRESS=

# --- Text sending (Send Texts tab) ---
# Optional — only needed for the Send Texts tab. Get these from the 8x8
# Developer Portal (https://developer.8x8.com/connect) under the existing
# 8x8 account/app — an API key and a subaccount ID, both shown there, not
# something to invent. Texts send through that 8x8 account directly.
EIGHTXEIGHT_API_KEY=
EIGHTXEIGHT_SUBACCOUNT_ID=
# Optional — an alphanumeric/numeric Sender ID shown as the "from" on the
# recipient's phone. Some 8x8 accounts require this, others use a default —
# leave blank to use the account's default sender.
EIGHTXEIGHT_SOURCE=

# Optional comma-separated phone numbers to offer in the "Send test text
# to" dropdown on the Send Texts tab (in addition to a "Custom..." option,
# which is always available). E.164 format recommended (+15551234567).
# Leave blank to only get "Custom...".
TEST_TEXT_NUMBERS=
